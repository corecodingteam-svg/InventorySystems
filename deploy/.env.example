# Copy to deploy/.env on the server and fill in. Never commit the real file.
ACME_EMAIL=info@advaitamaa.com
POSTGRES_DB=inventory
POSTGRES_USER=inventory
POSTGRES_PASSWORD=CHANGE_ME_long_random
JWT_SECRET=CHANGE_ME_long_random_string_64_chars

# Let's Encrypt CA. Leave as production for real certificates; setup.sh --staging
# overrides it with https://acme-staging-v02.api.letsencrypt.org/directory for dry runs.
ACME_CA=https://acme-v02.api.letsencrypt.org/directory

# First inventory admin (created once by setup.sh; password min 12 chars).
ORG_NAME=Advaitamaa
ADMIN_EMAIL=info@advaitamaa.com
ADMIN_PASSWORD=CHANGE_ME_admin_password
