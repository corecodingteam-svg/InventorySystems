# Copy to .env.development or .env.production and fill in real values.
# Never commit .env files with real secrets.

POSTGRES_DB=inventory
POSTGRES_USER=inventory
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgres://inventory:change_me@postgres:5432/inventory

REDIS_URL=redis://redis:6379

JWT_SECRET=change_me_to_a_long_random_string
PORT=3000

# Object storage (future S3/MinIO integration)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
